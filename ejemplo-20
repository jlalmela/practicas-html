<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Coca-Cola 3D</title>
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <style>
    * { margin:0; padding:0; box-sizing:border-box; }

    body {
      background:#0a0a0a;
      font-family: 'Arial Black', Arial, sans-serif;
      overflow-x: hidden;
    }

    /* Canvas fijo en el fondo */
    #canvas-wrap {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }
    
    canvas {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      display: block;
    }

    /* Contenedor de scroll para activar la animación */
    #scroll-container {
      position: relative;
      z-index: 1;
      height: 500vh;
      pointer-events: none;
    }

    /* Secciones de texto */
    .section {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      align-items: center;
      padding: 0 8vw;
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
    }
    .section.left  { justify-content: flex-start; }
    .section.right { justify-content: flex-end; }
    .section.center { justify-content: center; text-align: center; }

    .section h2 {
      font-size: clamp(2.5rem, 8vw, 7rem);
      font-weight: 900;
      line-height: 1.05;
      letter-spacing: -1px;
      text-transform: uppercase;
      max-width: 55vw;
    }

    .red    { color: #e8001c; }
    .white  { color: #ffffff; }
    .gold   { color: #f5c400; }
    .silver { color: #c0c0c0; }

    /* Pantalla de carga inicial */
    #msg {
      position: fixed; 
      inset: 0;
      display: flex; 
      align-items: center; 
      justify-content: center;
      color: #fff; 
      font-family: sans-serif; 
      background: #0a0a0a;
      z-index: 99; 
      font-size: 16px; 
      letter-spacing: 1px;
    }
  </style>
</head>
<body>

<div id="msg">Cargando Entorno 3D...</div>

<div id="canvas-wrap"></div>

<div id="scroll-container">
  <div class="section center" id="s0">
    <h2 class="red">Taste<br><span class="white">the feeling</span></h2>
  </div>
  <div class="section left" id="s1">
    <h2 class="gold">Siempre<br><span class="white">Coca‑Cola</span></h2>
  </div>
  <div class="section right" id="s2">
    <h2 class="white">Open<br><span class="red">happiness</span></h2>
  </div>
  <div class="section left" id="s3">
    <h2 class="silver">Refreshing<br><span class="red">since 1886</span></h2>
  </div>
  <div class="section center" id="s4">
    <h2 class="white">Share<br><span class="gold">a Coke</span></h2>
  </div>
</div>

<script>
  // --- Configuración e Inicio de la Escena 3D ---
  var container = document.getElementById('canvas-wrap');
  var scene = new THREE.Scene();

  var camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
  camera.position.z = 12;

  var renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth > 600 ? 500 : 320, 600);
  renderer.shadowMap.enabled = true;
  container.appendChild(renderer.domElement);

  // --- Iluminación ---
  var ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
  scene.add(ambientLight);

  var dirLight1 = new THREE.DirectionalLight(0xffffff, 0.8);
  dirLight1.position.set(5, 10, 7);
  scene.add(dirLight1);

  var pointLight = new THREE.PointLight(0xffffff, 0.6, 30);
  pointLight.position.set(0, 2, 6);
  scene.add(pointLight);

  // --- Generación de la Lata ---
  var canGroup = new THREE.Group();

  // Textura en alta definición autogenerada mediante Canvas 2D
  var canvasTex = document.createElement('canvas');
  canvasTex.width = 1024;
  canvasTex.height = 1024;
  var ctx = canvasTex.getContext('2d');

  ctx.fillStyle = '#e8001c';
  ctx.fillRect(0, 0, canvasTex.width, canvasTex.height);

  ctx.fillStyle = '#ffffff';
  ctx.font = 'italic bold 110px Georgia, serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText('Coca-Cola', canvasTex.width / 2, canvasTex.height / 2 - 20);

  ctx.strokeStyle = '#ffffff';
  ctx.lineWidth = 12;
  ctx.beginPath();
  ctx.moveTo(100, 650);
  ctx.bezierCurveTo(350, 450, 650, 750, 924, 550);
  ctx.stroke();

  var labelTexture = new THREE.CanvasTexture(canvasTex);
  var bodyGeo = new THREE.CylinderGeometry(2, 2, 5, 64, 1, true);
  var bodyMat = new THREE.MeshStandardMaterial({
    map: labelTexture,
    roughness: 0.15,
    metalness: 0.85
  });
  var canBody = new THREE.Mesh(bodyGeo, bodyMat);
  canGroup.add(canBody);

  // Tapas de aluminio metálico
  var silverMat = new THREE.MeshStandardMaterial({
    color: 0xcccccc,
    roughness: 0.2,
    metalness: 0.95
  });

  var topCapGeo = new THREE.CylinderGeometry(1.9, 2, 0.15, 64);
  var topCap = new THREE.Mesh(topCapGeo, silverMat);
  topCap.position.y = 2.5 + 0.075;
  canGroup.add(topCap);

  var bottomCapGeo = new THREE.CylinderGeometry(2, 1.8, 0.2, 64);
  var bottomCap = new THREE.Mesh(bottomCapGeo, silverMat);
  bottomCap.position.y = -2.5 - 0.1;
  canGroup.add(bottomCap);

  scene.add(canGroup);

  // Ocultamos el mensaje de carga inmediatamente
  document.getElementById('msg').style.display = 'none';

  // --- Animación por Scroll ---
  var targetRotY = 0;
  var currentRotY = 0;
  var targetX = 0;
  var currentX = 0;

  var sections = [
    document.getElementById('s0'),
    document.getElementById('s1'),
    document.getElementById('s2'),
    document.getElementById('s3'),
    document.getElementById('s4')
  ];
  var totalSections = sections.length;
  var canPositions = [0, -25, 25, 75, 50];

  function onScroll() {
    var scrollTop = window.scrollY;
    var maxScroll = document.body.scrollHeight - window.innerHeight;
    if (maxScroll <= 0) return;
    
    var progress = scrollTop / maxScroll;
    var sectionProgress = progress * (totalSections - 1);
    var idx0 = Math.floor(sectionProgress);
    var idx1 = Math.min(idx0 + 1, totalSections - 1);
    var t = sectionProgress - idx0;

    targetRotY = progress * Math.PI * 2 * (totalSections - 1);
    targetX = canPositions[idx0] * (1 - t) + canPositions[idx1] * t;

    sections.forEach(function(s, i) {
      var dist = Math.abs(sectionProgress - i);
      s.style.opacity = Math.max(0, 1 - dist * 2.5);
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // --- Bucle de Renderizado Continuo ---
  function animate() {
    requestAnimationFrame(animate);
    
    // Suavizado de movimientos (Lerp)
    currentRotY += (targetRotY - currentRotY) * 0.07;
    currentX    += (targetX    - currentX)    * 0.07;
    
    canGroup.rotation.y = currentRotY;
    canGroup.position.x = (currentX - 50) * 0.08;

    renderer.render(scene, camera);
  }
  animate();

  // Ajuste de tamaño de ventana automático
  window.addEventListener('resize', function() {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth > 600 ? 500 : 320, 600);
  });
</script>

</body>
</html>
